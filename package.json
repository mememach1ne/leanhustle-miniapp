{
  "name": "lean-poizon-monorepo",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @lean-poizon/web build",
    "build:api": "pnpm --filter @lean-poizon/api build",
    "build:bot": "pnpm --filter @lean-poizon/bot build",
    "dev": "pnpm --parallel --filter @lean-poizon/web --filter @lean-poizon/api --filter @lean-poizon/bot dev",
    "dev:web": "pnpm --filter @lean-poizon/web dev",
    "dev:api": "pnpm --filter @lean-poizon/api dev",
    "dev:bot": "pnpm --filter @lean-poizon/bot dev",
    "start:api": "pnpm --filter @lean-poizon/api start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "lint": "pnpm -r lint",
    "format": "pnpm exec prettier --write .",
    "prisma:migrate": "pnpm --filter @lean-poizon/api prisma:migrate",
    "prisma:push": "pnpm --filter @lean-poizon/api prisma:push",
    "prisma:seed": "pnpm --filter @lean-poizon/api prisma:seed",
    "prisma:studio": "pnpm --filter @lean-poizon/api prisma:studio",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm --filter @lean-poizon/api prisma:generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
