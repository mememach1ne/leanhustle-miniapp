########################################
# Shared
########################################
NODE_ENV=development

########################################
# Database
########################################
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lean_poizon

########################################
# API
########################################
API_HOST=0.0.0.0
PORT=3001
API_PORT=3002
CORS_ORIGIN=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
PRIVATE_CHANNEL_ID=
# Dewu / Poizon product API (dajisaas.com OpenAPI gateway).
DEWU_API_HOST=openapi.dajisaas.com
DEWU_API_APP_KEY=
DEWU_API_APP_SECRET=
DEWU_API_PRODUCT_ENDPOINT=/poizon/product/queryDetail
MANAGER_TELEGRAM_IDS=
BOT_INTERNAL_API_TOKEN=change-me-to-a-separate-internal-token

########################################
# Web
########################################
NEXT_PUBLIC_APP_NAME=LEAN POIZON
NEXT_PUBLIC_API_BASE_URL=/backend-api
NEXT_PUBLIC_AUTH_DEBUG_ADMIN_TELEGRAM_IDS=
BACKEND_API_ORIGIN=http://localhost:3002
TELEGRAM_MINI_APP_URL=http://localhost:3000

########################################
# Bot
########################################
BOT_API_URL=http://localhost:3002/api
BOT_LOG_LEVEL=info

########################################
# Seed
########################################
SEED_ADMIN_TELEGRAM_IDS=
SEED_ADMIN_USERNAMES=
SEED_MANAGER_TELEGRAM_IDS=
SEED_MANAGER_USERNAMES=
